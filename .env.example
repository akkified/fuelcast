# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# Where the app sends AI Coach requests. Point this at your deployed coach server so
# EVERY user can use the coach with no key of their own. Not secret (it's a URL).
EXPO_PUBLIC_COACH_API_URL=https://YOUR-SITE.netlify.app/api/coach

# Optional, development builds only (Expo Go on your own phone): talk to Grok directly.
# Ignored in production builds and the website.
EXPO_PUBLIC_XAI_API_KEY=

# The SERVER key goes in Netlify → Site configuration → Environment variables as:
#   XAI_API_KEY = xai-...
# (not in this file).
